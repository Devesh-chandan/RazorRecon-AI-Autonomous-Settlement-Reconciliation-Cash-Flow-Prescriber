
# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql://razorrecon:razorrecon@localhost:5432/razorrecon
# Cloud production (AWS RDS / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/razorrecon?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:
REDIS_URL=redis://localhost:6379/0
# Cloud production (Upstash / ElastiCache):
# REDIS_URL=rediss://:password@host:6380/0

# ── Razorpay Webhook ──────────────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → Webhooks → (your webhook) → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret key: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
